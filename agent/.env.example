# ─────────────────────────────────────────────────────────────────────────────
# Required: one API key
# ─────────────────────────────────────────────────────────────────────────────
# The agent talks to Gemini through Google's OpenAI-compatible endpoint, so a
# single Gemini key is all it needs. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: point the agent at any OpenAI-compatible provider
# ─────────────────────────────────────────────────────────────────────────────
# The agent uses the OpenAI SDK against a configurable base URL, so it runs on
# any OpenAI-compatible API without code changes. If you only have an OpenAI
# key, uncomment these three lines and the agent works unmodified.
#
#   LLM_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
LLM_MODEL=gemini-flash-lite-latest
#
# Key resolution order: GEMINI_API_KEY -> GOOGLE_API_KEY -> OPENAI_API_KEY

# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model used for per-file code generation and repair (the high-volume role).
# Validated against the provider's /models endpoint at startup — if it does not
# exist, the agent fails fast and prints the models you actually have access to.
# LLM_MODEL=gemini-flash-latest

# Model used for planning and review (few calls, high leverage). Defaults to
# LLM_MODEL. Set to a stronger model if your quota allows.
# LLM_PLANNER_MODEL=gemini-pro-latest

# ─────────────────────────────────────────────────────────────────────────────
# Optional: run limits
# ─────────────────────────────────────────────────────────────────────────────
# Repair attempts per task before it is marked `degraded` and the run moves on.
AGENT_MAX_REPAIRS=3

# Concurrent LLM calls within one topological level. Keep low on free tiers —
# the limiting factor is requests-per-minute, not throughput.
AGENT_CONCURRENCY=2

# Cache LLM responses on disk keyed by hash(prompt + model). Makes re-runs
# near-free and near-deterministic. Set to 0 to disable.
AGENT_CACHE=1