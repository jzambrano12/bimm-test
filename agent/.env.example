# ─────────────────────────────────────────────────────────────────────────────
# Required: one API key. Copy this file to .env — do not rename it.
# ─────────────────────────────────────────────────────────────────────────────
# The agent talks to Gemini through Google's OpenAI-compatible endpoint, so a
# single Gemini key is all it needs. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: run it on any OpenAI-compatible provider instead
# ─────────────────────────────────────────────────────────────────────────────
# The agent drives the OpenAI SDK against a configurable base URL, so it needs no
# code changes to use a different provider. If you have an OpenAI key rather than
# a Gemini one, uncomment these three lines and everything else works unchanged.
#
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-5-mini
#
# Use LLM_API_KEY rather than OPENAI_API_KEY when switching providers. It takes
# priority, so a GEMINI_API_KEY left in this file cannot be sent to the wrong
# endpoint by accident. Without it the order is
# GEMINI_API_KEY -> GOOGLE_API_KEY -> OPENAI_API_KEY.

# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model for per-file generation and repair — the high-volume role. Validated
# against the provider's /models endpoint at startup; if it does not exist the
# agent fails fast and prints the models your key can actually reach. Leave it
# unset to have a flash-class model auto-selected from that catalogue.
# LLM_MODEL=gemini-flash-lite-latest

# Model for planning and review: few calls, high leverage. Defaults to LLM_MODEL.
# Worth pointing at a stronger model than the generator if your quota allows —
# review is one call per run against roughly eight generations.
# LLM_PLANNER_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# Optional: run limits
# ─────────────────────────────────────────────────────────────────────────────
# Repair attempts per task before it is marked `degraded` and the run moves on.
# AGENT_MAX_REPAIRS=3

# Concurrent model calls within one dependency level. Keep this low on free
# tiers: the limiting factor is requests per minute, not throughput.
# AGENT_CONCURRENCY=2

# Cache model responses on disk, keyed by the full request. Makes re-runs nearly
# free and replays them exactly. Set to 0 to disable, or pass --no-cache.
# AGENT_CACHE=1

# ─────────────────────────────────────────────────────────────────────────────
# Optional: cost reporting
# ─────────────────────────────────────────────────────────────────────────────
# Per-million-token rates used to price a run. Only needed for a provider whose
# rates the agent does not know — it reports tokens without a dollar figure
# rather than guessing.
# LLM_PRICE_INPUT=0.30
# LLM_PRICE_OUTPUT=2.50
